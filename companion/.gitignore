node_modules/
eval-artifacts/
cases/
.qa-cases-root/
# Notification channel config (issue #58) — holds webhook URLs + SMTP passwords. Never commit.
notifications/
# Velociraptor client inventory (issue #70) — the fleet's real hostnames/FQDNs/IPs. ANCHORED so it
# matches companion/velociraptor/ (the data dir) but NOT companion/src/integrations/velociraptor/.
/velociraptor/
# Server + per-case session logs (DFIR_LOG_LEVEL). May contain case identifiers / activity traces.
logs/
dist/
*.timestamp-*.mjs
.env
# Ejected prompt overrides (`npm run prompts:eject`). ANCHORED so it matches companion/prompts/
# (the ejected copies an operator edits) but NOT companion/src/analysis/ai/prompts/ (the built-in
# prompt source). Unanchored, it silently swallowed the latter — same trap as /velociraptor/ above.
/prompts/
# Tesseract.js downloads the language model to the cwd on first OCR run
eng.traineddata
*.traineddata
# Generated by `npm run ocr:demo`
scripts/ocr-demo-out/

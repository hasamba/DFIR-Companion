{
  "name": "dfir-companion",
  "version": "0.35.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "node scripts/format-changed.mjs --write",
    "format:check": "node scripts/format-changed.mjs --check",
    "format:all": "prettier --write .",
    "check:size": "node scripts/check-file-size.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:us-map": "node scripts/check-us-map.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "inventory:dashboard": "node scripts/dashboard-inventory.mjs",
    "split:dashboard-section": "node scripts/dashboard-section-split.mjs",
    "pretest": "node scripts/clean-vitest-temp.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "eval": "tsx tests/eval/run.ts all",
    "eval:extraction": "tsx tests/eval/run.ts extraction",
    "eval:synthesis": "tsx tests/eval/run.ts synthesis",
    "eval:screenshots": "tsx tests/eval/run.ts screenshots",
    "eval:real": "tsx tests/eval/run.ts all --real",
    "eval:real:extraction": "tsx tests/eval/run.ts extraction --real",
    "eval:real:synthesis": "tsx tests/eval/run.ts synthesis --real",
    "eval:real:screenshots": "tsx tests/eval/run.ts screenshots --real",
    "eval:change-gate": "tsx tests/eval/checkChange.ts",
    "bench:storage": "tsx scripts/bench-case-storage.ts",
    "dev": "node --max-old-space-size=8192 --import tsx/esm src/server.ts",
    "verify:ai": "tsx scripts/verify-ai.ts",
    "ocr:demo": "tsx scripts/ocr-redact-demo.ts",
    "coverage": "tsx scripts/coverage.ts",
    "reanalyze": "tsx scripts/reanalyze.ts",
    "synthesize": "tsx scripts/synthesize.ts",
    "deep-pass": "tsx scripts/deep-pass.ts",
    "clean-timeline": "tsx scripts/clean-timeline.ts",
    "dedupe-iocs": "tsx scripts/dedupe-iocs.ts",
    "repair-ioc-values": "tsx scripts/repair-ioc-values.ts",
    "ocr-index": "tsx scripts/ocr-index.ts",
    "prompts:eject": "tsx scripts/eject-prompts.ts",
    "yeti": "tsx scripts/yeti-lookup.ts",
    "iris:push": "tsx scripts/push-iris.ts",
    "iris:import": "tsx scripts/import-iris.ts",
    "timesketch:push": "tsx scripts/push-timesketch.ts",
    "misp:push": "tsx scripts/push-misp.ts",
    "notion:push": "tsx scripts/push-notion.ts",
    "seed-demo": "tsx scripts/seed-demo-case.ts",
    "data:update-attack": "tsx scripts/update-attack-groups.ts",
    "data:update-d3fend": "tsx scripts/update-d3fend.ts",
    "data:update-attack-mitigations": "tsx scripts/update-attack-mitigations.ts",
    "data:update-geo": "tsx scripts/update-country-centroids.ts",
    "icons": "tsx scripts/make-icons.ts",
    "theme:map": "tsx scripts/theme/buildRoleMap.ts",
    "theme:check": "tsx scripts/theme/buildRoleMap.ts --check",
    "theme:apply": "tsx scripts/theme/applyRoles.ts",
    "theme:apply:dry": "tsx scripts/theme/applyRoles.ts --dry",
    "theme:import": "tsx scripts/theme/importThemePalettes.ts",
    "chrome:refresh-token": "tsx scripts/chrome-refresh-token.ts",
    "package:sea": "node scripts/build-sea.mjs",
    "package:appimage": "node scripts/build-appimage.mjs",
    "package:choco": "node scripts/build-choco.mjs"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "marked": "^18.0.4",
    "sharp": "^0.35.3",
    "tesseract.js": "^5.1.1",
    "undici": "^8.10.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.6",
    "rcedit": "^3.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.0.0"
  }
}

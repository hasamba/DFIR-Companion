# Shell scripts and Docker build files must stay LF even when checked out on Windows, or they
# break inside the Linux image: a `\r` gives bad-interpreter errors in scripts, trailing `\r`
# in .dockerignore patterns stops them matching, and CRLF can trip multi-line `RUN` continuations.
*.sh                 text eol=lf
docker-entrypoint.sh text eol=lf
Dockerfile           text eol=lf
.dockerignore        text eol=lf
docker-compose.yml   text eol=lf

# Bundled Sigma rules stay LF on every checkout, so the Windows EXE ships the same bytes as Linux
# and Docker (#2215). The rule hashes also ignore line endings, for analyst-supplied zips.
companion/data/sigma/** text eol=lf

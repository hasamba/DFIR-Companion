# Shell scripts and Docker build files must stay LF even when checked out on Windows, or they
# break inside the Linux image: a `\r` gives bad-interpreter errors in scripts, trailing `\r`
# in .dockerignore patterns stops them matching, and CRLF can trip multi-line `RUN` continuations.
*.sh                 text eol=lf
docker-entrypoint.sh text eol=lf
Dockerfile           text eol=lf
.dockerignore        text eol=lf
docker-compose.yml   text eol=lf

# Bundled Sigma rules stay LF on every checkout, so the Windows EXE ships the same bytes as Linux
# and Docker (#2215). The rule hashes also ignore line endings, for analyst-supplied zips.
companion/data/sigma/** text eol=lf

# Vitest snapshot files are compared byte for byte; a CRLF checkout on Windows CI would fail them.
companion/tests/**/__snapshots__/** text eol=lf

# Vendored AI-agent rules (#2690): same reason as data/sigma — the content hashes used for self-scan
# demotion and the rule-set digest that names the Velociraptor artifact must match on every platform.
companion/data/ai-agent-rules/** text eol=lf
companion/tests/fixtures/aiAgent/** text eol=lf
